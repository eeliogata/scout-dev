API_HOST=127.0.0.1
API_PORT=8000
API_KEY=

DATABASE_URL=
AIVEN_TOKEN=
TEST_DATABASE_URL=
CONTEXT_DEV_API_KEY=
CONTEXT_DEV_TIMEOUT_SECONDS=25
# Set to socks5h://127.0.0.1:9050 when collecting onion sources.
TOR_SOCKS_PROXY=
GEMINI_API_KEY=
GEMINI_FILTER_MODEL=gemini-4-hydrogen
EMBEDDING_MODEL=gemini-embedding-001

MODAL_INFERENCE_URL=
MODAL_INFERENCE_TOKEN=
ANALYSIS_PROVIDER=gemini
ANALYSIS_MODEL=gemini-4-carbon
ANALYSIS_MODEL_REVISION=
# To use Qwen, replace the three ANALYSIS settings above with:
# ANALYSIS_PROVIDER=modal
# ANALYSIS_MODEL=Qwen/Qwen3-32B
# ANALYSIS_MODEL_REVISION=9216db5781bf21249d130ec9da846c4624c16137
MODAL_GPU=H100
ANALYSIS_CONTEXT_LENGTH=8192

# Source scan_interval_seconds controls scheduling (default: 86400).
WORKER_POLL_SECONDS=2
ANALYSIS_BATCH_SIZE=4

# Public read-only demo access; enables Continue as guest.
GUEST_ACCESS_ENABLED=false

# Optional member-only Telegram alert delivery; server-side only.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
